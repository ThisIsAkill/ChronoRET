#!/usr/bin/env bash
# pre-commit / commit-msg hook.
#   pre-commit:  author/committer identity, blocked-pattern scan, staged
#                paths, ROM byte-exact match, full-coverage verify,
#                readability gate, regenerated progress (symbols/),
#                review-log validation
#   commit-msg:  commit message text against the same blocked-pattern scan
#
# Install:   make install-hook
# Skip once: git commit --no-verify

set -euo pipefail

RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; RESET='\033[0m'
fail() { printf "${RED}[pre-commit] %s${RESET}\n" "$*" >&2; exit 1; }
warn() { printf "${YELLOW}[pre-commit] WARNING: %s${RESET}\n" "$*" >&2; }
ok()   { printf "${GREEN}[pre-commit] %s${RESET}\n" "$*"; }
info() { printf '[pre-commit] %s\n' "$*"; }

# Bracketed so this file does not match itself.
PATTERN='c[l]aude|a[n]thropic|co-authored-b[y]|generated wit[h]|\bll[m]\b|\ba[i]\b'
IDENT='Akhil Moola <goudakhil29@gmail.com>'

scan() {
    # stdin: text to check; $1: label
    local hits
    hits=$(grep -inE "$PATTERN" || true)
    [ -z "$hits" ] || fail "$1 matches blocked pattern:"$'\n'"$hits"
}

mode=$(basename "$0")

if [ "$mode" = "commit-msg" ]; then
    grep -v '^#' "$1" | scan "commit message"
    exit 0
fi

# ── Identity ──────────────────────────────────────────────────────────────────
for var in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
    who=$(git var "$var" | sed -E 's/ [0-9]+ [+-][0-9]{4}$//')
    [ "$who" = "$IDENT" ] || fail "$var is '$who', expected '$IDENT'"
done

staged=$(git diff --cached --name-only --diff-filter=ACMR)

# ── 0. Local-only docs (session notes, workflow doc) must never be committed ─
bad=$(printf '%s\n' "$staged" | grep -E '(^|/)(C[L]AUDE\.md|CT_WORKFLOW\.md|KICKOFF[^/]*\.md|\.c[l]aude/|SESSION[^/]*\.md)' || true)
[ -z "$bad" ] || fail "ignored local file staged:"$'\n'"$bad"
bad=$(printf '%s\n' "$staged" | grep -iE '\.(sfc|smc)$' || true)
[ -z "$bad" ] || fail "ROM file staged:"$'\n'"$bad"
printf '%s\n' "$staged" | scan "staged path"

# Content (added lines only). `|| true` keeps pipefail from aborting
# silently when nothing new is staged (e.g. a message-only amend).
{ git diff --cached -U0 --no-color --diff-filter=ACMR \
    | grep -E '^\+' | grep -vE '^\+\+\+ ' || true; } | scan "staged content"

# ── 1. ROM byte-exact diff ────────────────────────────────────────────────────
if [ ! -f roms/chrono_trigger.sfc ]; then
    info "No ROM at roms/chrono_trigger.sfc — skipping diff check."
else
    info "Checking ROM match..."
    if ! make diff --no-print-directory -s 2>/dev/null; then
        fail "ROM does not match after reassembly. Run 'make diff' to debug."
    fi
    ok "MATCH: byte-exact."
    info "Checking every source-emitted byte (independent of base ROM)..."
    if [ -f tools/verify.py ]; then
        python3 tools/verify.py >/dev/null || fail "tools/verify.py found source bytes that differ from the ROM."
    fi
    ok "VERIFIED: full coverage."
fi

# ── 1b. Readability standard ─────────────────────────────────────────────────
info "Checking readability standard..."
# (Guarded: branches cut from before the gate don't have the lint yet.)
if [ -f tools/lint_readability.py ]; then
    python3 tools/lint_readability.py || fail "Readability gate failed (see above; rules in tools/lint_readability.py)."
fi

# ── 2. Generated numbers and the review log (symbols/) ──────────────────────
# Counts are never typed by hand: regenerate them and stage the result, so
# symbols/ and the README/CONTRIBUTING/STATUS blocks always match the code.
# (Guarded: older checkouts sharing this hook may not have these tools yet.)
if [ -f tools/validate_functions.py ] && [ -d symbols ] && [ -f roms/chrono_trigger.sfc ]; then
    info "Regenerating symbols/ and progress blocks..."
    python3 tools/progress.py --update >/dev/null || fail "tools/progress.py --update failed."
    git add symbols/functions.csv symbols/progress.json README.md CONTRIBUTING.md STATUS.md 2>/dev/null || true
fi
if [ -f tools/validate_functions.py ] && [ -d symbols ]; then
    python3 tools/validate_functions.py >/dev/null || { python3 tools/validate_functions.py; fail "symbols/ is invalid."; }
    ok "symbols/ valid."
fi

ok "All checks passed."
exit 0
